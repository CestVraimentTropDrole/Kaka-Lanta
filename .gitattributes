# Auto detect text files and normalize line endings to LF
* text=auto

# Unity files
*.cs text diff=csharp
*.cginc text
*.shader text
*.mat text
*.anim text
*.unity text
*.prefab text
*.physicMaterial text
*.asset text
*.meta text
*.controller text

# Unity YAML
*.meta text merge=unityyamlmerge
*.prefab text merge=unityyamlmerge
*.unity text merge=unityyamlmerge
*.asset text merge=unityyamlmerge
*.controller text merge=unityyamlmerge

# Image formats
*.png binary
*.jpg binary
*.psd binary
*.tga binary
*.exr binary

# Audio formats
*.mp3 binary
*.wav binary
*.ogg binary

# 3D models
*.fbx binary
*.obj binary
*.blend binary
*.mb binary
*.ma binary

# Other binary files
*.dll binary
*.exe binary
*.unitypackage binary